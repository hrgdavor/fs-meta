<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        RELEASE ENTRY POINT - not the normal build.

        This is a copy of pom.xml, not a child of it: pom.xml packages a jar, and Maven 3.9.9 refuses a
        jar-packaged POM as a parent ("Invalid packaging for parent POM ... must be 'pom' but is 'jar'").
        Maven also has no POM include, so the POM is duplicated. The intended differences are this comment
        block and the Central publisher plugin in the top-level <build> below, which pom.xml deliberately does
        not carry. maven.deploy.skip stays true here too: it disables maven-deploy-plugin, not the publisher
        (a separate goal at the same phase), so if the publisher extension ever failed to load, a release
        would do nothing rather than fall back to a direct deploy. scripts/check-poms.mjs strips comments,
        removes the publisher plugin from this file, and fails if the two POMs are not otherwise identical -
        so a change to pom.xml must be copied here in the same commit.

        Release (real Maven, not mvnd), with JDK 25 and the Central token in ~/.m2/settings.xml:

            <maven-home>\bin\mvn.cmd -f pom-release.xml -Ppublish -Dgpg.skip=false -DskipTests deploy

        Never test this POM by running deploy without a skip: pass -DskipPublishing=true (the publisher's own
        parameter, default false), which still proves the release path reaches the publisher without uploading.

        The release depends on the released `hr.hrg:wyhash:1.2.0`; see publishing.md.
    -->

    <groupId>hr.hrg</groupId>
    <artifactId>fs-meta</artifactId>
    <version>0.3.7</version>
    <packaging>jar</packaging>

    <name>fs-meta</name>
    <description>
        The file-system state of one codebase folder as a trio of files — a compact binary index
        (files.meta), its LF-delimited names (files.txt) and a JSON sidekick (files.json) — so that a
        watcher can maintain it once and every other tool can ask "is this file still what I indexed?"
        without walking the tree. The format is specified in FORMAT.md; the Java, Bun and (later) Zig
        implementations all assert the same conformance vectors.
    </description>
    <url>https://github.com/hrgdavor/fs-meta</url>

    <licenses>
        <license>
            <name>GPL-3.0 with the Commons Clause</name>
            <url>https://github.com/hrgdavor/fs-meta</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>hrgdavor</id>
            <name>Davor Hrg</name>
            <url>https://github.com/hrgdavor</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/hrgdavor/fs-meta.git</connection>
        <developerConnection>scm:git:ssh://git@github.com:hrgdavor/fs-meta.git</developerConnection>
        <url>https://github.com/hrgdavor/fs-meta</url>
    </scm>

    <!--
        No parent means no managed versions, so everything this build uses is pinned here. The values are the
        ones `jcodebuddy-parent` pins, kept identical on purpose: this project is built by the same reactor and
        the same JDK 25, and a different compiler or surefire version here would be a difference nobody asked
        for.
    -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>

        <wyhash.version>1.2.0</wyhash.version>
        <gitignore.version>0.3.5</gitignore.version>
        <junit.version>5.10.2</junit.version>

        <maven.compiler.plugin.version>3.11.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.2.5</maven.surefire.plugin.version>
        <maven.jar.plugin.version>3.3.0</maven.jar.plugin.version>
        <maven.install.plugin.version>3.1.4</maven.install.plugin.version>
        <maven.deploy.plugin.version>3.1.2</maven.deploy.plugin.version>
        <maven.source.plugin.version>3.3.1</maven.source.plugin.version>
        <maven.javadoc.plugin.version>3.11.2</maven.javadoc.plugin.version>
        <maven.gpg.plugin.version>3.2.7</maven.gpg.plugin.version>
        <central.publishing.plugin.version>0.6.0</central.publishing.plugin.version>

        <!-- Signing is off by default so local builds never wait on a passphrase; a release passes -Dgpg.skip=false. -->
        <gpg.skip>true</gpg.skip>
        <!--
            PUBLISHING GUARD, RELEASE HALF. pom.xml has no publisher and sets maven.deploy.skip=true, so a
            normal build never loads the extension and a bare `mvn deploy` is a no-op. This release copy adds
            the publisher below but keeps maven.deploy.skip=true: the skip disables maven-deploy-plugin, not
            the Central publisher, which is a separate goal at the same phase. If the publisher extension
            failed to load, the release would therefore do nothing instead of uploading directly.
        -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!--
            The one hash the format uses: `wyhash64`, seed 0 — the same coordinates this file has always
            resolved, now at `1.2.0` because the implementation this project needs (zero-allocation `String`,
            `MemorySegment`, the generated vectors) lives there and `1.0.0` did not have it.

            THE HASH IS NOT BUILT HERE (DEC-050). `hr.hrg:wyhash` has its own repository
            (github.com/hrgdavor/wyhash); this dependency resolves from Maven Central at the released `1.2.0`.
            `mvn -pl :fs-meta` therefore does NOT build its own dependency, and `-am` no longer reaches it: a
            "cannot resolve hr.hrg:wyhash" failure means the artifact or the repository is missing, not that the
            POM is wrong.

            `1.2.0` is the release version, not a snapshot: Central rejects a release whose POM depends on
            a SNAPSHOT; `hr.hrg:wyhash:1.2.0` is on Maven Central. Do not put a SNAPSHOT back into a release POM.

            Both ports of this format still hash with the SAME CODE rather than with the same algorithm: this
            artifact is the Java half, and the Bun half imports the same project's `@hrg/wyhash` package. The vectors prove it either way —
            `conformance/fsmeta-vectors.json`'s `hashCases` pin the values, and the wyhash project's own
            generated vectors pin them against the Zig builtin reference.
        -->
        <dependency>
            <groupId>hr.hrg</groupId>
            <artifactId>wyhash</artifactId>
            <version>${wyhash.version}</version>
        </dependency>

        <!--
            The `.gitignore` matcher, from the project that owns it: `hr.hrg:gitignore` (DEC-051). This project
            implements no matcher of its own and carries no copy — `FsMetaScanner` calls
            `hr.hrg.gitignore.GitIgnoreFile` / `GitIgnoreRules`, whose API is the one the deleted local copies
            had. The Zig side takes the same project through `build.zig.zon` at the same version, so all three
            walks are the same rules.

            Resolved the way `wyhash` is: from the local repository (install the gitignore checkout once with
            `mvn install`), or from Maven Central once 0.2.0 is released. A "cannot resolve hr.hrg:gitignore"
            failure means that install is missing.
        -->
        <dependency>
            <groupId>hr.hrg</groupId>
            <artifactId>gitignore</artifactId>
            <version>${gitignore.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
                <configuration>
                    <parallel>none</parallel>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven.jar.plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>${maven.install.plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>${maven.deploy.plugin.version}</version>
            </plugin>
            <!--
                The Central publisher. It is here, in the top-level <build> of the release POM, because Maven
                reads <extensions> only from the build and never from a profile: declared in the publish
                profile it was silently never loaded, and `deploy` staged a bundle without uploading it or
                saying "central". It takes over deploy and suppresses maven-deploy-plugin, and it is a separate
                goal at the same phase, so maven.deploy.skip=true above does not stop it - it stops the plugin
                that would otherwise upload a non-bundle directly.
                skipPublishing is left at the plugin's default (false). Pass -DskipPublishing=true to exercise
                this path without uploading.
            -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>${central.publishing.plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <autoPublish>true</autoPublish>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>publish</id>
            <build>
                <plugins>
                    <!-- Central requires a sources jar and a javadoc jar next to the binary. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven.source.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven.javadoc.plugin.version}</version>
                        <configuration>
                            <doclint>none</doclint>
                            <additionalOptions>
                                <additionalOption>--no-fonts</additionalOption>
                            </additionalOptions>
                            <source>${maven.compiler.release}</source>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Signing: skipped unless -Dgpg.skip=false. The passphrase comes from MAVEN_GPG_PASSPHRASE,
                         so a headless build never waits on a prompt. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven.gpg.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <skip>${gpg.skip}</skip>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <distributionManagement>
        <snapshotRepository>
            <id>central</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </snapshotRepository>
        <repository>
            <id>central</id>
            <url>https://central.sonatype.com/repository/maven-releases/</url>
        </repository>
    </distributionManagement>
</project>
