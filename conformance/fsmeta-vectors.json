  "gitignoreCases": [
    {
      "label": "basic-glob",
      "explain": "a basename pattern excludes at any depth",
      "files": [
        "a.txt",
        "debug.log"
      ],
      "gitignores": {
        ".gitignore": "*.log\n"
      },
      "included": [
        ".gitignore",
        "a.txt"
      ],
      "includedWithoutGitignore": [
        ".gitignore",
        "a.txt",
        "debug.log"
      ]
    },
    {
      "label": "negation-reincludes",
      "explain": "the last matching pattern wins",
      "files": [
        "a.txt",
        "debug.log",
        "keep.log"
      ],
      "gitignores": {
        ".gitignore": "*.log\n!keep.log\n"
      },
      "included": [
        ".gitignore",
        "a.txt",
        "keep.log"
      ]
    },
    {
      "label": "anchored-pattern",
      "explain": "a leading slash anchors to the ignore file's directory",
      "files": [
        "root-only.txt",
        "sub/root-only.txt"
      ],
      "gitignores": {
        ".gitignore": "/root-only.txt\n"
      },
      "included": [
        ".gitignore",
        "sub/root-only.txt"
      ]
    },
    {
      "label": "unanchored-matches-any-depth",
      "explain": "a name-only pattern excludes directories too",
      "files": [
        "build/x.txt",
        "keep.txt",
        "sub/build/y.txt"
      ],
      "gitignores": {
        ".gitignore": "build\n"
      },
      "included": [
        ".gitignore",
        "keep.txt"
      ]
    },
    {
      "label": "directory-only-pattern",
      "explain": "a trailing slash means directories only",
      "files": [
        "keep.txt",
        "out.txt",
        "out/x.txt"
      ],
      "gitignores": {
        ".gitignore": "out/\n"
      },
      "included": [
        ".gitignore",
        "keep.txt",
        "out.txt"
      ]
    },
    {
      "label": "nested-gitignore-overrides-outer",
      "explain": "a deeper file beats a shallower one",
      "files": [
        "root.tmp",
        "src/a.tmp",
        "src/b.txt",
        "src/keep.tmp"
      ],
      "gitignores": {
        ".gitignore": "*.tmp\n",
        "src/.gitignore": "!keep.tmp\n"
      },
      "included": [
        ".gitignore",
        "src/.gitignore",
        "src/b.txt",
        "src/keep.tmp"
      ]
    },
    {
      "label": "excluded-directory-cannot-be-reincluded",
      "explain": "a negation cannot resurrect a file in a pruned directory",
      "files": [
        "a.js",
        "node_modules/keep.txt",
        "node_modules/x.js"
      ],
      "gitignores": {
        ".gitignore": "node_modules/\n!node_modules/keep.txt\n"
      },
      "included": [
        ".gitignore",
        "a.js"
      ]
    },
    {
      "label": "double-star-in-the-middle",
      "explain": "**/ between two segments covers zero or more directories",
      "files": [
        "docs/a.md",
        "docs/x/b.md",
        "docs/x/d.txt",
        "docs/x/y/c.md"
      ],
      "gitignores": {
        ".gitignore": "docs/**/*.md\n"
      },
      "included": [
        ".gitignore",
